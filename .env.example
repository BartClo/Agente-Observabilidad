# Copiar a .env. Nunca commitear .env real (ver .gitignore).

# --- Postgres (checkpointer / memoria) ---
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
POSTGRES_DB=agents
DATABASE_URL=postgresql://agent:agent@postgres:5432/agents

# --- Modelo ---
ANTHROPIC_API_KEY=

# --- rag/ (ver rag/README.md) ---
OPENAI_API_KEY=
RAG_EMBEDDING_MODEL=text-embedding-3-small

# --- Agente aiops (ver docs/aiops-agent.md) ---
# Autonomia: 0 observa, 1 recomienda, 2 con aprobacion, 3 autonomo bajo riesgo, 4 + rollback
AIOPS_AUTONOMY_LEVEL=1
AIOPS_ALLOWED_ENVS=dev,staging
AIOPS_ALLOWED_SERVICES=
AIOPS_CONFIDENCE_THRESHOLD=0.8
AIOPS_MAX_RETRIES=2
# Kill switch: AIOPS_KILL_SWITCH=1, o crear el archivo indicado en AIOPS_KILL_SWITCH_FILE.
# Ignorado si AIOPS_PERSISTENCIA=postgres (usa la tabla aiops_kill_switch en cambio).
AIOPS_KILL_SWITCH=
AIOPS_KILL_SWITCH_FILE=
AIOPS_AUDIT_FILE=
# memoria (default: se pierde al reiniciar) | postgres (incidentes/auditoria/kill
# switch en las tablas aiops_* de DATABASE_URL; correr `make migrate` antes)
AIOPS_PERSISTENCIA=memoria
# simulado (banco experimental) | prometheus (solo lectura: observa, recomienda, escala)
AIOPS_BACKEND=simulado
# formato categoria:servicio separado por coma; vacio = un fallo de cada categoria
AIOPS_SIM_FAULTS=
AIOPS_PROMETHEUS_URL=
AIOPS_LOKI_URL=
AIOPS_SERVICE_LABEL=service

# --- infra/ (ver infra/README.md). Servicios opcionales: sumar su nombre a
# COMPOSE_PROFILES separado por coma (ej. COMPOSE_PROFILES=redis,qdrant,garage) ---
COMPOSE_PROFILES=
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
S3_ENDPOINT_URL=http://garage:3900
S3_REGION=garage
S3_ACCESS_KEY=agent-access-key
S3_SECRET_KEY=agentagent-secret
S3_DEFAULT_BUCKET=default

# --- Langfuse (opcional, sumar "langfuse" a COMPOSE_PROFILES) ---
LANGFUSE_NEXTAUTH_SECRET=changeme
LANGFUSE_SALT=changeme
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
