# Copiar a .env. Nunca commitear .env real (ver .gitignore).

# --- Postgres (checkpointer / memoria) ---
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
POSTGRES_DB=agents
DATABASE_URL=postgresql://agent:agent@postgres:5432/agents

# --- Modelo ---
ANTHROPIC_API_KEY=

# --- rag/ (ver rag/README.md) ---
OPENAI_API_KEY=
RAG_EMBEDDING_MODEL=text-embedding-3-small

# --- infra/ (ver infra/README.md). Servicios opcionales: sumar su nombre a
# COMPOSE_PROFILES separado por coma (ej. COMPOSE_PROFILES=redis,qdrant,garage) ---
COMPOSE_PROFILES=
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
S3_ENDPOINT_URL=http://garage:3900
S3_REGION=garage
S3_ACCESS_KEY=agent-access-key
S3_SECRET_KEY=agentagent-secret
S3_DEFAULT_BUCKET=default

# --- Langfuse (opcional, sumar "langfuse" a COMPOSE_PROFILES) ---
LANGFUSE_NEXTAUTH_SECRET=changeme
LANGFUSE_SALT=changeme
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
