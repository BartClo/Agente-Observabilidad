# Copiar a .env. Nunca commitear .env real (ver .gitignore).

# --- Postgres (checkpointer / memoria) ---
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
POSTGRES_DB=agents
DATABASE_URL=postgresql://agent:agent@postgres:5432/agents

# --- Modelo ---
ANTHROPIC_API_KEY=

# --- rag/ (ver rag/README.md) ---
OPENAI_API_KEY=
RAG_EMBEDDING_MODEL=text-embedding-3-small

# --- Agente aiops (ver docs/aiops-agent.md) ---
# Autonomia: 0 observa, 1 recomienda, 2 con aprobacion, 3 autonomo bajo riesgo, 4 + rollback
AIOPS_AUTONOMY_LEVEL=1
AIOPS_ALLOWED_ENVS=dev,staging
AIOPS_ALLOWED_SERVICES=
AIOPS_CONFIDENCE_THRESHOLD=0.8
AIOPS_MAX_RETRIES=2
# Kill switch: AIOPS_KILL_SWITCH=1, o crear el archivo indicado en AIOPS_KILL_SWITCH_FILE.
# Ignorado si AIOPS_PERSISTENCIA=postgres (usa la tabla aiops_kill_switch en cambio).
AIOPS_KILL_SWITCH=
AIOPS_KILL_SWITCH_FILE=
AIOPS_AUDIT_FILE=
# memoria (default: se pierde al reiniciar) | postgres (incidentes/auditoria/kill
# switch en las tablas aiops_* de DATABASE_URL; correr `make migrate` antes)
AIOPS_PERSISTENCIA=memoria
# simulado (banco experimental) | prometheus (solo lectura: observa, recomienda, escala)
AIOPS_BACKEND=simulado
# formato categoria:servicio separado por coma; vacio = un fallo de cada categoria
AIOPS_SIM_FAULTS=
AIOPS_PROMETHEUS_URL=
AIOPS_LOKI_URL=
AIOPS_SERVICE_LABEL=service
AIOPS_DISK_MOUNTPOINT=/
# Backend de acciones (Fase 4), solo con AIOPS_BACKEND=prometheus: ninguna | k8s
AIOPS_ACTIONS=ninguna
AIOPS_K8S_API=
AIOPS_K8S_NAMESPACE=aiops-lab
AIOPS_K8S_TOKEN_FILE=
AIOPS_K8S_CA_FILE=
# Verificacion con espera: segundos que se sondea la recuperacion (0 = una lectura)
AIOPS_VERIFY_WINDOW_S=0
AIOPS_VERIFY_INTERVAL_S=5
# Confirmacion: segundos que se reintenta solo si NO hay datos de la metrica (0 = una lectura)
AIOPS_CONFIRM_WINDOW_S=0
# Worker (Fase 6): lock por servicio, timeout y reintentos de los jobs
AIOPS_LOCK_TTL_S=900
AIOPS_LOCK_ESPERA_S=30
AIOPS_JOB_TIMEOUT_S=900
AIOPS_JOB_REINTENTOS=2
# LLM: timeout por llamada (s) y reintentos del cliente. Las acciones sobre el backend
# tienen su timeout de reloj en domain/aiops_core/acciones.py (60-120 s segun la accion).
AIOPS_LLM_TIMEOUT_S=120
AIOPS_LLM_REINTENTOS=2
# Incidentes sin cierre tras tantos segundos se verifican y cierran o se escalan solos
AIOPS_RECONCILIAR_EDAD_S=1800
# Cortacircuito entre incidentes: maximo de acciones sobre un mismo servicio en la ventana
# (0 = apagado). Evita el bucle "reinicio -> reaparece -> otro incidente -> otro reinicio"
AIOPS_BREAKER_MAX=3
AIOPS_BREAKER_WINDOW_S=3600
# Agente que corre el worker: "unico" (tool-calling, el normal) o "deepagents" (orquestador
# + subagente de la plantilla, solo como brazo de comparacion del experimento)
AIOPS_AGENTE=unico
# Avisos a Google Chat (espacio > Aplicaciones e integraciones > Webhooks). La URL lleva
# key y token: es un SECRETO (no commitear). Vacia = sin avisos. Solo https://chat.googleapis.com
AIOPS_GCHAT_WEBHOOK_URL=
# Enlace a la UI que se agrega a los avisos que piden accion humana (opcional)
AIOPS_UI_URL=
# API HTTP (Fase 2): token compartido, cabecera "Authorization: Bearer <token>".
AIOPS_API_TOKEN=
# Configuracion del LLM desde la UI (proveedor, modelo, API key). Token de admin aparte:
AIOPS_ADMIN_TOKEN=
# Clave maestra con la que se cifran las API keys en Postgres. Generar con:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Si cambia, las keys guardadas hay que volver a cargarlas.
AIOPS_SECRETS_KEY=

# --- infra/ (ver infra/README.md). Servicios opcionales: sumar su nombre a
# COMPOSE_PROFILES separado por coma (ej. COMPOSE_PROFILES=redis,qdrant,garage) ---
COMPOSE_PROFILES=
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
S3_ENDPOINT_URL=http://garage:3900
S3_REGION=garage
S3_ACCESS_KEY=agent-access-key
S3_SECRET_KEY=agentagent-secret
S3_DEFAULT_BUCKET=default

# --- Langfuse (opcional, sumar "langfuse" a COMPOSE_PROFILES) ---
LANGFUSE_NEXTAUTH_SECRET=changeme
LANGFUSE_SALT=changeme
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
