# Copiar a aiops.env (no versionado) y completar. Solo nombres: ningun valor real aqui.
# Valores aleatorios largos, por ejemplo: openssl rand -hex 32
AIOPS_DB_PASSWORD=
AIOPS_API_TOKEN=
AIOPS_ADMIN_TOKEN=
# Clave Fernet (no sirve un hex cualquiera). Generarla con:
#   docker run --rm aiops-agent:local python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIOPS_SECRETS_KEY=
# Nombre exacto de la red de la plataforma (docker network ls). Candidatos:
# ai-factory-platform_ia-factory-network, ai-factory-dev_ia-factory-network, ai-factory_ia-factory-network
AIOPS_RED_PLATAFORMA=
AIOPS_GCHAT_WEBHOOK_URL=
# Proveedor del LLM: pendiente pasar por el llm-gateway de la plataforma.
